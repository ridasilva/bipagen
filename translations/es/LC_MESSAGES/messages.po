#: /home/rsilva/Documents/bipagen/app/templates/index.html:81
msgid "Public Universities"
msgstr "Universidades Públicas"

#: /home/rsilva/Documents/bipagen/app/templates/index.html:87
msgid "1 — Basic Strains"
msgstr "1 — Cepas Básicas"

#: /home/rsilva/Documents/bipagen/app/templates/index.html:88
msgid "Common, non-pathogenic, easy to cultivate."
msgstr "Comunes, no patógenas, fáciles de cultivar."

#: /home/rsilva/Documents/bipagen/app/templates/index.html:89
msgid "wild-type Saccharomyces cerevisiae"
msgstr "Saccharomyces cerevisiae silvestre"

#: /home/rsilva/Documents/bipagen/app/templates/index.html:94
msgid "2 — Standard Strains"
msgstr "2 — Cepas Estándar"

#: /home/rsilva/Documents/bipagen/app/templates/index.html:95
msgid ""
"Non-pathogenic bacteria, yeasts, and filamentous fungi with specific "
"characteristics."
msgstr ""
"Bacterias, levaduras y hongos filamentosos no patógenos con "
"características específicas."

#: /home/rsilva/Documents/bipagen/app/templates/index.html:96
msgid "non-toxigenic"
msgstr "no toxigénico"

#: /home/rsilva/Documents/bipagen/app/templates/index.html:101
msgid "3 — Specialized Strains"
msgstr "3 — Cepas Especializadas"

#: /home/rsilva/Documents/bipagen/app/templates/index.html:102
msgid ""
"Biosafety Level 2 (BSL-2) pathogens, fastidious microorganisms, or "
"strains with common vectors/plasmids."
msgstr ""
"Patógenos de Nivel de Bioseguridad 2 (BSL-2), microorganismos exigentes o"
" cepas con vectores/plásmidos comunes."

#: /home/rsilva/Documents/bipagen/app/templates/index.html:103
msgid "plasmid"
msgstr "plásmido"

#: /home/rsilva/Documents/bipagen/app/templates/index.html:108
msgid "4 — Premium Strains"
msgstr "4 — Cepas Premium"

#: /home/rsilva/Documents/bipagen/app/templates/index.html:109
msgid ""
"Patented strains, high commercial value, complex genetic constructs, or "
"BSL-3 pathogens (with specific legal restrictions)."
msgstr ""
"Cepas patentadas, de alto valor comercial, con construcciones genéticas "
"complejas o patógenos de BSL-3 (con restricciones legales específicas)."

#: /home/rsilva/Documents/bipagen/app/templates/index.html:110
msgid "Patented enzyme/antibody-producing strains"
msgstr "Cepas patentadas productoras de enzimas/anticuerpos"

#: /home/rsilva/Documents/bipagen/app/templates/index.html:110
msgid "specific knockout strains"
msgstr "cepas knockout específicas"

#: /home/rsilva/Documents/bipagen/app/templates/index.html:117
msgid "Important Notes"
msgstr "Notas Importantes"

#: /home/rsilva/Documents/bipagen/app/templates/index.html:119
msgid "Documentation:"
msgstr "Documentación:"

#: /home/rsilva/Documents/bipagen/app/templates/index.html:119
msgid ""
"All prices include a basic technical datasheet. Certificate of Analysis "
"(viability, purity, confirmatory molecular test) incurs an additional "
"fee."
msgstr ""
"Todos los precios incluyen una ficha técnica básica. El Certificado de "
"Análisis (viabilidad, pureza, prueba molecular confirmatoria) tiene un "
"costo adicional."

#: /home/rsilva/Documents/bipagen/app/templates/index.html:120
msgid "Licenses:"
msgstr "Licencias:"

#: /home/rsilva/Documents/bipagen/app/templates/index.html:120
msgid ""
"Patented strains are subject to Material Transfer Agreements (MTA) and "
"may require additional licensing fees not included in the listed price."
msgstr ""
"Las cepas patentadas están sujetas a Acuerdos de Transferencia de "
"Material (MTA) y pueden requerir tarifas de licencia adicionales no "
"incluidas en el precio indicado."

#: /home/rsilva/Documents/bipagen/app/templates/index.html:121
msgid "Shipping:"
msgstr "Envío:"

#: /home/rsilva/Documents/bipagen/app/templates/index.html:121
msgid ""
"Not included. Shipping costs (special packaging with dry ice or "
"recyclable ice) are calculated separately and borne by the buyer."
msgstr ""
"No incluido. Los costos de envío (embalaje especial con hielo seco o "
"hielo reciclable) se calculan por separado y los asume el comprador."

#: /home/rsilva/Documents/bipagen/app/templates/index.html:128
msgid "Main Goals"
msgstr "Objetivos Principales"

#: /home/rsilva/Documents/bipagen/app/templates/index.html:130
msgid ""
"Establish physical infrastructure for long-term microbial conservation "
"(-80°C, lyophilization, cryopreservation)."
msgstr ""
"Establecer infraestructura física para la conservación microbiana a largo"
" plazo (-80°C, liofilización, criopreservación)."

#: /home/rsilva/Documents/bipagen/app/templates/index.html:131
msgid ""
"Create a computerized system for strain registration, traceability, and "
"access."
msgstr ""
"Crear un sistema informatizado para el registro, la trazabilidad y el "
"acceso de las cepas."

#: /home/rsilva/Documents/bipagen/app/templates/index.html:132
msgid "Implement biosafety protocols with BSL-1 and BSL-2 containment levels."
msgstr ""
"Implementar protocolos de bioseguridad con niveles de contención BSL-1 y "
"BSL-2."

#: /home/rsilva/Documents/bipagen/app/templates/index.html:133
msgid ""
"Develop a database interconnected with national and international "
"collection networks."
msgstr ""
"Desarrollar una base de datos interconectada con redes nacionales e "
"internacionales de colecciones."

#: /home/rsilva/Documents/bipagen/app/templates/index.html:134
msgid ""
"Train users in safe handling and legal documentation of microbial "
"resources."
msgstr ""
"Capacitar a los usuarios en la manipulación segura y la documentación "
"legal de los recursos microbianos."

#: /home/rsilva/Documents/bipagen/app/templates/index.html:135
msgid ""
"Promote open access for the scientific community and companies with a "
"transparent usage policy."
msgstr ""
"Promover el acceso abierto para la comunidad científica y las empresas "
"con una política de uso transparente."

